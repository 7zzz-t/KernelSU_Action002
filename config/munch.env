# KernelSU Action -- build profile for Xiaomi POCO F4 / Redmi K40S (munch)
#
# Run it with:  Actions -> Build Kernel -> Config file to build =
#               config/munch.env
#
# Kernel source: LineageOS android_kernel_xiaomi_sm8250 @ lineage-23.2
#   Linux 4.19.325, Qualcomm kona (SM8250). Non-GKI, so:
#     - KSU_VARIANT=sukisu-ultra with KSU_REF=builtin (source-integrated tree
#       that ships SUSFS itself; avoids susfs4ksu's stale non-GKI patches)
#     - KSU_HOOK_MODE=manual (kprobes is unreliable on 4.x)
#     - ENABLE_PATH_UMOUNT=true (path_umount() landed in 5.9)
#
# LineageOS ships this tree as defconfig fragments (see
# android_device_xiaomi_sm8250-common/BoardConfigCommon.mk):
#   vendor/kona-perf_defconfig
#     + vendor/debugfs.config
#     + vendor/xiaomi/sm8250-common.config
#     + vendor/xiaomi/munch.config
# DEFCONFIG_FRAGMENTS merges them into vendor/munch_defconfig before the build.

CONFIG_ENV=config/munch.env

# ============================================================ Kernel source ==

KERNEL_SOURCE=https://github.com/LineageOS/android_kernel_xiaomi_sm8250
KERNEL_SOURCE_BRANCH=lineage-23.2
KERNEL_CONFIG=vendor/kona-perf_defconfig
DEFCONFIG_FRAGMENTS=vendor/debugfs.config vendor/xiaomi/sm8250-common.config vendor/xiaomi/munch.config
KERNEL_IMAGE_NAME=Image
ARCH=arm64
KERNEL_NAME=munch

ADD_LOCALVERSION_TO_FILENAME=false

# BoardConfigCommon.mk sets BOARD_KERNEL_IMAGE_NAME := Image and the tree
# builds with clang only (TARGET_KERNEL_NO_GCC := true). The 4.x trees need
# the old toolchain; lld as the linker plus lenient strict-prototypes matches
# the pattern verified on the sibling wayne 4.19 tree.
EXTRA_CMDS:LD=ld.lld KCFLAGS=-Wno-error=strict-prototypes
CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-

# =================================================================== Clang ==

CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r450784e
# If r450784e is too old for this 2026-updated 4.19.325 tree (unlikely but
# possible), switch to CLANG_BRANCH=main-kernel-2025 / CLANG_VERSION=r547379.

USE_CUSTOM_CLANG=false
CUSTOM_CLANG_SOURCE=
CUSTOM_CLANG_BRANCH=

USE_LLVM=false

# ===================================================================== GCC ==

ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true
USE_CUSTOM_GCC_64=false
CUSTOM_GCC_64_SOURCE=
CUSTOM_GCC_64_BRANCH=
CUSTOM_GCC_64_BIN=aarch64-linux-android-
USE_CUSTOM_GCC_32=false
CUSTOM_GCC_32_SOURCE=
CUSTOM_GCC_32_BRANCH=
CUSTOM_GCC_32_BIN=arm-linux-androideabi-

# =============================================================== KernelSU ===

KSU_VARIANT=sukisu-ultra
KSU_REF=builtin
KSU_HOOK_MODE=manual

KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# =================================================================== SUSFS ==

ENABLE_SUSFS=true
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_BRANCH=auto

# ========================================================== Extra patches ===

ENABLE_PATH_UMOUNT=true
ENABLE_HIDE_STUFF=true

# KPM is a SukiSU-Ultra 'main' (v4 modular) feature; the 'builtin' tree used
# here does not ship patch_linux, so keep this off.
ENABLE_KPM=false

# ================================================================ Kconfig ===

ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=true
DISABLE_LTO=false
DISABLE_CC_WERROR=true

EXTRA_DEFCONFIG=

# ============================================================= AnyKernel3 ===

USE_CUSTOM_ANYKERNEL3=false
CUSTOM_ANYKERNEL3_SOURCE=
CUSTOM_ANYKERNEL3_BRANCH=

# ============================================================== Packaging ===

# munch uses a separated DTBO (BOARD_KERNEL_SEPARATED_DTBO := true). We build
# the same kernel tree as stock LineageOS, so the dtb output is identical and
# the stock dtbo partition can be left untouched. Enable NEED_DTBO=true only
# if you also want the built dtbo.img uploaded as an artifact.
NEED_DTBO=false

# Repack boot.img around the new Image. SOURCE_BOOT_IMAGE is the stock
# LineageOS boot image for munch (same ROM era as the kernel source).
BUILD_BOOT_IMG=true
SOURCE_BOOT_IMAGE=https://mirrorbits.lineageos.org/full/munch/20260810/boot.img

# ================================================================= Runner ===

ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
