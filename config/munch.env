# KernelSU Action -- build profile for Xiaomi POCO F4 / Redmi K40S (munch)
#
# Run it with:  Actions -> Build Kernel -> Config file to build =
#               config/munch.env
#
# Kernel: LineageOS android_kernel_xiaomi_sm8250 @ lineage-23.2
#         (Linux 4.19.325, Qualcomm kona/SM8250, Non-GKI)
#
# Notes:
#  * LineageOS splits the defconfig into fragments (kona-perf_defconfig +
#    debugfs.config + sm8250-common.config + munch.config). This action only
#    builds ONE defconfig file, so the device fragments are folded into
#    EXTRA_DEFCONFIG below (the same lines, space separated).
#  * CONFIG_CMDLINE="cgroup_disable=pressure ramoops_memreserve=4M" from
#    sm8250-common.config cannot be expressed here (value contains spaces);
#    it is a fallback that only applies when the bootloader passes no cmdline,
#    and the stock boot image carries a full cmdline, so the impact is minimal.
#  * SUSFS is OFF: susfs4ksu's kernel-side patch (50_add_susfs_in_kernel-4.19)
#    does not apply to this vendor tree. SukiSU-Ultra 'builtin' still ships the
#    SUSFS Kconfig, so re-enabling it later only needs the patch adapted.

CONFIG_ENV=config/munch.env

# ============================================================ Kernel source ==

KERNEL_SOURCE=https://github.com/LineageOS/android_kernel_xiaomi_sm8250
KERNEL_SOURCE_BRANCH=lineage-23.2
KERNEL_CONFIG=vendor/kona-perf_defconfig
KERNEL_IMAGE_NAME=Image
ARCH=arm64
KERNEL_NAME=munch

ADD_LOCALVERSION_TO_FILENAME=false

# The tree builds with clang only; lld as the linker plus lenient
# strict-prototypes matches the pattern verified on the sibling wayne 4.19 tree.
EXTRA_CMDS:LD=ld.lld KCFLAGS=-Wno-error=strict-prototypes
CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-

# =================================================================== Clang ==

# First attempt used r450784e (clang 12 / lld 12), which FAILS at the vmlinux
# link step: this tree's arch/arm64/Makefile hardcodes `-z notext` for
# CONFIG_RELOCATABLE, and lld only supports it since lld 14. r547379 (clang
# 18/19) matches LineageOS 23's own toolchain generation for this kernel.
CLANG_BRANCH=main-kernel-2025
CLANG_VERSION=r547379

# Fallback if the newer clang ever trips over 4.x code: back to
#   CLANG_BRANCH=master-kernel-build-2022 / CLANG_VERSION=r450784e
#   and drop "LD=ld.lld" from EXTRA_CMDS so the GNU ld 4.9 binutils (which
#   supports -z notext) does the link instead.

USE_CUSTOM_CLANG=false
CUSTOM_CLANG_SOURCE=
CUSTOM_CLANG_BRANCH=

USE_LLVM=false

# ===================================================================== GCC ==

ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true
USE_CUSTOM_GCC_64=false
CUSTOM_GCC_64_SOURCE=
CUSTOM_GCC_64_BRANCH=
CUSTOM_GCC_64_BIN=aarch64-linux-android-
USE_CUSTOM_GCC_32=false
CUSTOM_GCC_32_SOURCE=
CUSTOM_GCC_32_BRANCH=
CUSTOM_GCC_32_BIN=arm-linux-androideabi-

# =============================================================== KernelSU ===

# 'builtin' is the source-integrated non-GKI tree of SukiSU-Ultra and the most
# compatible ref for a 4.19 kernel.
KSU_VARIANT=sukisu-ultra
KSU_REF=builtin

# kprobes is unreliable on 4.x; manual hooks are patched into the syscall
# entry points instead.
KSU_HOOK_MODE=manual

KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# =================================================================== SUSFS ==

# OFF. Two independent reasons:
#  * susfs4ksu's kernel-side patch (50_add_susfs_in_kernel-4.19) does not apply
#    to this vendor tree.
#  * SukiSU-Ultra 'builtin' declares CONFIG_KSU_SUSFS with `default y`, so the
#    SUSFS include in kernel_includes.h would be active and fail to find
#    linux/susfs.h. CONFIG_KSU_SUSFS=n in EXTRA_DEFCONFIG below overrides that
#    default; every SUSFS code path in builtin is #ifdef-guarded, so the build
#    then compiles cleanly without SUSFS.
# To re-enable later: integrate the SUSFS sources into the kernel and drop
# CONFIG_KSU_SUSFS=n from EXTRA_DEFCONFIG.
ENABLE_SUSFS=false
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_BRANCH=auto

# ========================================================== Extra patches ===

# path_umount() is backported textually into fs/namespace.c (kernel < 5.9).
ENABLE_PATH_UMOUNT=true

# hide_stuff is SUSFS-oriented and its patch targets stock trees; leave off.
ENABLE_HIDE_STUFF=false

# KPM belongs to SukiSU-Ultra 'main' (v4 modular tree); 'builtin' does not
# ship patch_linux.
ENABLE_KPM=false

# ================================================================ Kconfig ===

ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=true
DISABLE_LTO=false
DISABLE_CC_WERROR=true

# munch defconfig fragments (vendor/xiaomi/sm8250-common.config +
# vendor/xiaomi/munch.config), folded into one line for this action.
# CONFIG_KSU_SUSFS=n overrides SukiSU-Ultra builtin's `default y` so the build
# does not require the SUSFS kernel sources (see the SUSFS section above).
EXTRA_DEFCONFIG=CONFIG_KSU_SUSFS=n CONFIG_BUILD_ARM64_DT_OVERLAY=y CONFIG_QCA_CLD_WLAN=y CONFIG_QCA_CLD_WLAN_PROFILE="qca6390" CONFIG_DEBUG_FS=n CONFIG_MSM_TZ_LOG=n CONFIG_CMA_DEBUGFS=n CONFIG_REGMAP_ALLOW_WRITE_DEBUGFS=n CONFIG_IPA_UT=n CONFIG_IOMMU_TESTS=n CONFIG_QMP_DEBUGFS_CLIENT=n CONFIG_EXFAT_FS=y CONFIG_EROFS_FS=y CONFIG_PSTORE=y CONFIG_PSTORE_CONSOLE=y CONFIG_PSTORE_PMSG=y CONFIG_PSTORE_RAM=y CONFIG_BLK_WBT=y CONFIG_BLK_WBT_SQ=y CONFIG_MTD=y CONFIG_MTD_BLOCK=y CONFIG_MTD_OOPS=y CONFIG_MTD_BLOCK2MTD=y CONFIG_BACKLIGHT_KTZ8866=y CONFIG_BACKLIGHT_DUALKTZ8866=y CONFIG_MOTOR_DRV8846=y CONFIG_AIROHA_GPS=y CONFIG_HALL_AKM09970=y CONFIG_ION_CAMERA_HEAP=y CONFIG_RC_CORE=y CONFIG_LIRC=y CONFIG_RC_DECODERS=y CONFIG_RC_DEVICES=y CONFIG_IR_SPI=y CONFIG_INPUT_XIAOMI_KEYBOARD=y CONFIG_KEYBOARD_NANO_8030=y CONFIG_LEDS_AW2015=y CONFIG_FRAME_WARN=4096 CONFIG_SMB1355_SLAVE_CHARGER=n CONFIG_SMB1390_CHARGE_PUMP_PSY=n CONFIG_SMB1398_CHARGER=n CONFIG_I2C_RETRY=y CONFIG_REGULATOR_PM8008=y CONFIG_REGULATOR_QCOM_RPMH=y CONFIG_TOUCHSCREEN_FTS=n CONFIG_TOUCHSCREEN_SYNAPTICS_DSX=n CONFIG_TOUCHSCREEN_SYNAPTICS_TCM=n CONFIG_TOUCHSCREEN_ST=n CONFIG_TOUCHSCREEN_COMMON=y CONFIG_PS5169=y CONFIG_INPUT_QTI_HAPTICS=n CONFIG_MACH_XIAOMI_MUNCH=y CONFIG_TOUCHSCREEN_FOCALTECH_3658U=y CONFIG_TOUCHSCREEN_XIAOMI_TOUCHFEATURE=y CONFIG_TOUCHSCREEN_SUPPORT_NEW_GAME_MODE=y CONFIG_INPUT_FINGERPRINT=y CONFIG_FINGERPRINT_FPC=y CONFIG_FINGERPRINT_GOODIX=y CONFIG_QPNP_SMB5=n CONFIG_QPNP_SMB5_MUNCH=y CONFIG_BQ2597X_CHARGE_PUMP_STANDALONE_MUNCH=y CONFIG_CHARGER_LN8000_MUNCH=y CONFIG_FUEL_GAUGE_BQ27Z561_MUNCH=y CONFIG_US_PROXIMITY=y CONFIG_INPUT_AW86927_HAPTIC=y CONFIG_TECHPACK_CAMERA_XIAOMI=y

# ============================================================= AnyKernel3 ===

USE_CUSTOM_ANYKERNEL3=false
CUSTOM_ANYKERNEL3_SOURCE=
CUSTOM_ANYKERNEL3_BRANCH=

# ============================================================== Packaging ===

# munch uses a separated DTBO; same kernel tree as stock, so the stock dtbo
# partition is left untouched. Enable NEED_DTBO=true only if you want the
# built dtbo.img uploaded as an artifact.
NEED_DTBO=false

# Repack boot.img around the new Image from the stock LineageOS boot image.
BUILD_BOOT_IMG=true
SOURCE_BOOT_IMAGE=https://mirrorbits.lineageos.org/full/munch/20260810/boot.img

# ================================================================= Runner ===

ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
